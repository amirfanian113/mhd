{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mhd",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "847ed4e7-2b50-49f1-b92d-83c9d60f792f","database_name": "mhd" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e8af5f19c14b44f48fa0b0702ca3d2ec" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
